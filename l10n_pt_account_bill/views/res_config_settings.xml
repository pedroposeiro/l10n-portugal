<odoo>
    <data>
        <!--
            Porte 19: o alvo //div[@name='integration'] deixou de existir e a
            página de definições passou a <app>/<block>/<setting>. Reescrito
            como um <block> "BILL / AT" no app general_settings, mantendo todos
            os campos (credenciais do software de faturação BILL e da AT).
        -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.bill</field>
            <field name="priority" eval="200" />
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//app[@name='general_settings']" position="inside">
                    <block title="BILL / AT" name="l10n_pt_account_bill">
                        <setting id="bill_settings"
                                 string="Faturação (BILL / AT)"
                                 help="Credenciais do software de faturação BILL e do portal da AT.">
                            <div class="content-group" name="bill_options">
                                <div class="mt16">
                                    <a href="https://www.app.bill.com/users/api" target="_blank"
                                       rel="noopener noreferrer">
                                        <i class="fa fa-arrow-right"/> Generate an API key
                                    </a>
                                </div>
                                <div class="mt16">
                                    <label for="bill_account_name" string="BILL Account Name"/>
                                    <field name="bill_account_name"/>
                                </div>
                                <div class="mt16">
                                    <label for="bill_api_token" string="BILL API Key"/>
                                    <field name="bill_api_token"/>
                                </div>
                                <div class="mt16">
                                    <label for="bill_template_id" string="BILL Invoice Email Template"/>
                                    <field name="bill_template_id"/>
                                </div>
                                <div class="mt16">
                                    <label for="username_at" string="AT Username"/>
                                    <field name="username_at"/>
                                </div>
                                <div class="mt16">
                                    <label for="password_at" string="AT Password"/>
                                    <field name="password_at" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

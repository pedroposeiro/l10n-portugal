<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_pt_account_bill.action_open_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Anular Fatura</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.invoice.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <!-- Account Move form view extended -->
    <record model="ir.ui.view" id="view_account_move_form">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Porte 19: o chatter deixou de ser <field name="message_ids"> e
                 passou a <chatter/>; open_attachments é atributo directo. -->
            <xpath expr="//chatter" position="attributes">
                <attribute name="open_attachments">True</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="%(l10n_pt_account_bill.action_open_cancel_wizard)d"
                        string="Anular"
                        type="action"
                        class="btn-danger"
                        invisible="state == 'cancel'"/>
            </xpath>

            <div name="journal_div" position="after">
                <field name="can_bill" invisible="1" />
                <field name="can_bill_email" invisible="1" />
                <field
                    name="bill_doc_type"
                    readonly="posted_before == True" invisible="can_bill == False"
                />
                <field name="process" readonly="1"/>
                <field name="defunct" readonly="1"/>

            </div>

            <xpath expr="//notebook//page[@name='other_info']" position="after">
                <page
                    name="bill"
                    string="BILL"
                    invisible="bill_id == False"
                >
                    <group>
                        <field name="bill_id" />
                        <field name="bill_permalink" widget="url" />
                    </group>
                </page>
            </xpath>
            <button name="action_invoice_sent" position="attributes">
                <attribute name="invisible">can_bill == True</attribute>
            </button>
            <button name="preview_invoice" position="before">
                <!--button
                    name="action_create_bill_invoice"
                    string="Create BILL"
                    type="object"
                    invisible="(can_bill == False or bill_id != False)"
                    groups="base.group_no_one"
                /-->
                
                <button
                    name="action_send_bill_email"
                    string="Email BILL2"
                    type="object"
                    invisible="(can_bill_email == False or bill_id == False)"
                />
            </button>

        </field>
    </record>

    <record id="view_invoice_cancel_wizard_form" model="ir.ui.view">
        <field name="name">account.invoice.cancel.wizard.form</field>
        <field name="model">account.invoice.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar Anulação">
                <group>
                    <field name="reason" placeholder="Informe o motivo da anulação (obrigatório)"/>
                </group>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm_cancel" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

<odoo>
    <data>
        <!--
            Porte 19: acrescenta o template de email de guia de remessa à
            config do BILL. O div[@name='bill_options'] agora vive dentro do
            <setting> reescrito no l10n_pt_account_bill; herda-se dessa vista
            e insere-se lá dentro.
        -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.bill.stock</field>
            <field name="priority" eval="210" />
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="l10n_pt_account_bill.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <div name="bill_options" position="inside">
                    <div class="mt16">
                        <label for="bill_delivery_template_id" string="Bill Delivery Email"/>
                        <field name="bill_delivery_template_id"/>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>
